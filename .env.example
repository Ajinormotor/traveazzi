# Copy to .env and fill in real values. .env is gitignored.

# Base URL for the Traveazi REST API.
EXPO_PUBLIC_API_URL=https://traveazi.onrender.com/api

# Google Maps Embed API key, used by components/MapEmbed.tsx.
# Without it MapEmbed renders the static fallback image instead of the map.
# The key must have "Maps Embed API" ENABLED in Google Cloud, or the embed
# returns 403 and the map area shows Google's error page instead of a map.
# This value is bundled into the app and readable by anyone, so restrict the
# key by Android package + signing SHA-1 and limit it to Maps Embed API.
EXPO_PUBLIC_GOOGLE_MAPS_KEY=your_maps_embed_api_key_here
